# Production settings. deploy/make-env.sh creates .env from this file with random passwords.
# Never commit .env.

# --- Public address -----------------------------------------------------------
# Your domain name, pointing (DNS A record) at the server's IP, e.g. origami.example.com.
# For a first test by IP address only, use DOMAIN=:80 (plain HTTP, no certificate).
DOMAIN=change-me.example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# --- Docker Compose: local dependencies -------------------------------------
MONGO_ROOT_USER=origami
MONGO_ROOT_PASSWORD=change-me-mongo
REDIS_PASSWORD=change-me-redis

# --- Application (read by api and worker; prefix ORIGAMI_) -------------------
ORIGAMI_ENV=production
# Used when the API runs on your host. Inside Compose, the hostnames are overridden to mongo/redis.
ORIGAMI_MONGO_URI=mongodb://origami:change-me-mongo@localhost:27017/?authSource=admin
ORIGAMI_MONGO_DB=origami_evolve
ORIGAMI_REDIS_URL=redis://:change-me-redis@localhost:6379/0
ORIGAMI_STORAGE_ROOT=./data
# Comma-separated browser origins allowed by CORS.
ORIGAMI_CORS_ORIGINS=https://change-me.example.com
ORIGAMI_READINESS_TIMEOUT_S=2

# --- Worker concurrency (bounded; see docs/PLAN.md section 1.4) --------------
INGEST_CONCURRENCY=2
ORIGAMI_OPTIMIZE_CONCURRENCY=2

# --- Uploads and ingestion limits (docs/input-formats.md) --------------------
ORIGAMI_MAX_UPLOAD_BYTES=524288000
# Limit for every other (JSON) request body
ORIGAMI_MAX_JSON_BODY_BYTES=1048576
ORIGAMI_INGEST_BATCH_SIZE=1000
ORIGAMI_INGEST_MAX_ROWS=5000000
ORIGAMI_INGEST_MAX_DESIGNS=100000
ORIGAMI_INGEST_MAX_ERRORS=10000
ORIGAMI_INGEST_MAX_STAPLES_PER_DESIGN=5000
ORIGAMI_INGEST_MAX_CANDIDATES_PER_STAPLE=16
ORIGAMI_INGEST_MAX_SCAFFOLD_LENGTH=20000
ORIGAMI_INGEST_MAX_STAPLE_LENGTH=500
ORIGAMI_INGEST_ALLOW_N=false
ORIGAMI_REPORT_SAMPLES_PER_CODE=20

# --- Batch optimization (M3) --------------------------------------------------
ORIGAMI_BATCH_MAX_DESIGNS=1000
ORIGAMI_JOB_STALE_AFTER_S=300
ORIGAMI_JOB_MAX_STALE_REQUEUES=2
ORIGAMI_REAPER_INTERVAL_S=60

# --- Structures (M7): oxDNA / caDNAno import ---------------------------------
ORIGAMI_MAX_STRUCTURE_BYTES=104857600
ORIGAMI_STRUCTURE_MAX_NUCLEOTIDES=500000
# Optional caDNAno -> oxDNA conversion: directory containing tacoxDNA's cadnano_oxDNA.py,
# as seen INSIDE the api and worker containers (needs a bind mount; see README). Leave unset to disable.
# ORIGAMI_TACOXDNA_DIR=/opt/tacoxdna      (mounted from ./tools/tacoxdna)
ORIGAMI_CONVERTER_TIMEOUT_S=600
# Optional oxDNA relaxation/simulation: path to a LINUX oxDNA executable inside the api and worker-ingest
# containers (needs a bind mount; see README). Leave unset to disable.
# ORIGAMI_OXDNA_BIN=/opt/oxdna/oxDNA      (mounted from ./tools/oxdna)
ORIGAMI_SIMULATION_TIMEOUT_S=3600

# Batch settings limits and search method (defaults shown)
# ORIGAMI_GA_MAX_POPULATION=500
# ORIGAMI_GA_MAX_GENERATIONS=1000
# ORIGAMI_EXHAUSTIVE_AUTO_MAX=4096
# ORIGAMI_EXHAUSTIVE_MAX_COMBINATIONS=1048576
