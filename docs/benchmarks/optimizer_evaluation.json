      },
      {
        "name": "staple_scaffold_complementarity",
        "version": "1.0.0",
        "kind": "computational_proxy",
        "description": "Mean fraction of Watson-Crick complementary bases between each staple and the reverse of the scaffold segment given by its start/end positions.",
        "limitations": "Computational proxy for staple-scaffold base pairing only; not a measure of folding yield, stability or kinetics. Counts matches, so it ignores nearest-neighbour thermodynamics, mismatch type and position, salt and temperature. Assumes start..end is one contiguous scaffold segment (index-aligned, antiparallel); staples spanning crossovers, loops/skips or circular wrap-around are not supported.",
        "requires": "scaffold sequence; start and end per staple (and variant) with end - start + 1 = length"
      }
    ],
    "note": "Synthetic problems; scores are computational proxies, not folding measurements."
